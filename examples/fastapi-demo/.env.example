# Settings for fastapi-demo - PLACEHOLDERS ONLY. Commit this file, never .env.
# Real secrets are injected at runtime: Kubernetes Secrets (Sealed/External Secrets),
# a vault, or CI/CD masked variables. Do not store real credentials in a .env file.

APP_ENV=development
LOG_LEVEL=INFO
# DATABASE_URL=<injected-at-runtime>
# API_KEY=<injected-at-runtime>
